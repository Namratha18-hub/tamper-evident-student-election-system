# Copy this file to .env and fill in your values
PORT=5000
# Local:  mongodb://127.0.0.1:27017/tamper_evident_election
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/tamper_evident_election
MONGO_URI=mongodb://127.0.0.1:27017/tamper_evident_election
SESSION_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Secret phrase that lets the election officer reset a forgotten password. Keep it private.
ADMIN_RECOVERY_KEY=choose-a-long-secret-phrase